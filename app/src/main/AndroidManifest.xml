<?xml version="1.0" encoding="utf-8"?>
<!--
  The application manifest. There is no network permission on purpose: the
  engine is offline, and the app must be installable and usable in airplane
  mode. Backup is disabled for the last-session state, and the single activity
  declares its exported flag explicitly.

  The engine's runtime dependency (JNA) declares storage and telephony
  permissions that this application does not use, so they are removed here
  rather than inherited by every installation.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fretboard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A19: a link shared from another app. `text/plain` only, because that is
              the traffic the parser reads, and `SEND` only — `ACTION_VIEW` is
              deliberately not declared, since serving it would mean claiming a web
              origin this application has no approved one of yet (DEC-07). No App Links
              metadata is declared for the same reason.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
